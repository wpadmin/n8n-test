{
  "name": "Автопарсинг всего канала",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "id": "schedule-trigger",
      "name": "Каждые 30 секунд",
      "notes": "Запускает workflow каждые 30 секунд"
    },
    {
      "parameters": {
        "operation": "select",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "bot_settings",
          "mode": "list"
        },
        "returnAll": true,
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [200, 0],
      "id": "get-settings",
      "name": "Загрузить настройки",
      "notes": "Встроенный Select — одна строка со всеми настройками"
    },
    {
      "parameters": {
        "url": "=http://telegram-client:3000/channel/{{ $json.target_channel_id }}/post/{{ $json.target_post_id }}/comments",
        "method": "GET",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 0],
      "id": "get-comments",
      "name": "Получить комментарии",
      "notes": "HTTP GET к Telegram Client"
    },
    {
      "parameters": {
        "fieldToSplitOut": "comments",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [600, 0],
      "id": "split-comments",
      "name": "Разбить комментарии",
      "notes": "Split Out — массив comments → отдельные items"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-sender",
              "leftValue": "={{ $json.senderId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "has-message",
              "leftValue": "={{ $json.message }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [800, 0],
      "id": "filter-valid",
      "name": "Есть отправитель и текст?",
      "notes": "Только комментарии с senderId и message"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "senderId",
              "name": "senderId",
              "value": "={{ String($json.senderId) }}",
              "type": "string"
            },
            {
              "id": "username",
              "name": "username",
              "value": "={{ $json.senderUsername }}",
              "type": "string"
            },
            {
              "id": "firstName",
              "name": "firstName",
              "value": "={{ $json.senderFirstName }}",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "={{ $json.message }}",
              "type": "string"
            },
            {
              "id": "channelId",
              "name": "channelId",
              "value": "={{ String($('Получить комментарии').first().json.channelId) }}",
              "type": "string"
            },
            {
              "id": "postId",
              "name": "postId",
              "value": "={{ $('Получить комментарии').first().json.postId }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1000, 0],
      "id": "map-fields",
      "name": "Подготовить поля",
      "notes": "Set — маппит поля + добавляет channelId и postId"
    },
    {
      "parameters": {
        "operation": "select",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "user_contacts",
          "mode": "list"
        },
        "returnAll": true,
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1000, 200],
      "id": "load-contacts",
      "name": "Загрузить контакты",
      "notes": "Встроенный Select — все записи из user_contacts"
    },
    {
      "parameters": {
        "mode": "combineBySql",
        "combineBySql": "SELECT * FROM input1 WHERE input1.senderId NOT IN (SELECT CAST(input2.user_chat_id AS TEXT) FROM input2)"
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [1200, 0],
      "id": "filter-new",
      "name": "Только новые",
      "notes": "Merge SQL — оставляет комментаторов, которых НЕТ в user_contacts"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "senderId",
              "name": "senderId",
              "value": "={{ $json.senderId }}",
              "type": "string"
            },
            {
              "id": "channelId",
              "name": "channelId",
              "value": "={{ $json.channelId }}",
              "type": "string"
            },
            {
              "id": "postId",
              "name": "postId",
              "value": "={{ $json.postId }}",
              "type": "number"
            },
            {
              "id": "greeting",
              "name": "greeting",
              "value": "={{ $('Загрузить настройки').first().json.greeting_template }}",
              "type": "string"
            },
            {
              "id": "link",
              "name": "link",
              "value": "={{ $('Загрузить настройки').first().json.registration_link }}",
              "type": "string"
            },
            {
              "id": "cta",
              "name": "cta",
              "value": "={{ $('Загрузить настройки').first().json.cta_template }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1400, 0],
      "id": "prepare-message",
      "name": "Подготовить сообщение",
      "notes": "Собирает senderId + шаблоны из настроек"
    },
    {
      "parameters": {
        "url": "http://telegram-client:3000/send",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"userId\": $json.senderId,\n  \"message\": $json.greeting + \"\\n\\n\" + $json.link + \"\\n\\n\" + $json.cta\n} }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1600, 0],
      "id": "send-message",
      "name": "Отправить сообщение",
      "notes": "ЛС через Telegram Client"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "user_chat_id",
              "name": "user_chat_id",
              "value": "={{ $('Подготовить сообщение').item.json.senderId }}",
              "type": "number"
            },
            {
              "id": "channel_id",
              "name": "channel_id",
              "value": "={{ $('Подготовить сообщение').item.json.channelId }}",
              "type": "string"
            },
            {
              "id": "post_id",
              "name": "post_id",
              "value": "={{ $('Подготовить сообщение').item.json.postId }}",
              "type": "number"
            },
            {
              "id": "last_contacted_at",
              "name": "last_contacted_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1800, 0],
      "id": "prepare-contact",
      "name": "Подготовить контакт",
      "notes": "Set — данные для записи в user_contacts"
    },
    {
      "parameters": {
        "operation": "upsert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "user_contacts",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": ["user_chat_id", "channel_id", "post_id"],
          "value": null
        },
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [2000, 0],
      "id": "update-contact",
      "name": "Обновить контакт",
      "notes": "Встроенный Upsert — записывает в user_contacts"
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2200, 0],
      "id": "wait-node",
      "name": "Пауза 1 сек",
      "notes": "Антиспам задержка"
    }
  ],
  "connections": {
    "Каждые 30 секунд": {
      "main": [
        [{"node": "Загрузить настройки", "type": "main", "index": 0}]
      ]
    },
    "Загрузить настройки": {
      "main": [
        [
          {"node": "Получить комментарии", "type": "main", "index": 0},
          {"node": "Загрузить контакты", "type": "main", "index": 0}
        ]
      ]
    },
    "Получить комментарии": {
      "main": [
        [{"node": "Разбить комментарии", "type": "main", "index": 0}]
      ]
    },
    "Разбить комментарии": {
      "main": [
        [{"node": "Есть отправитель и текст?", "type": "main", "index": 0}]
      ]
    },
    "Есть отправитель и текст?": {
      "main": [
        [{"node": "Подготовить поля", "type": "main", "index": 0}],
        []
      ]
    },
    "Подготовить поля": {
      "main": [
        [{"node": "Только новые", "type": "main", "index": 0}]
      ]
    },
    "Загрузить контакты": {
      "main": [
        [{"node": "Только новые", "type": "main", "index": 1}]
      ]
    },
    "Только новые": {
      "main": [
        [{"node": "Подготовить сообщение", "type": "main", "index": 0}]
      ]
    },
    "Подготовить сообщение": {
      "main": [
        [{"node": "Отправить сообщение", "type": "main", "index": 0}]
      ]
    },
    "Отправить сообщение": {
      "main": [
        [{"node": "Подготовить контакт", "type": "main", "index": 0}]
      ]
    },
    "Подготовить контакт": {
      "main": [
        [{"node": "Обновить контакт", "type": "main", "index": 0}]
      ]
    },
    "Обновить контакт": {
      "main": [
        [{"node": "Пауза 1 сек", "type": "main", "index": 0}]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
